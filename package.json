{
	"name": "n8n-nodes-agent-output-guard",
	"version": "0.1.0",
	"description": "Check agent text for length, JSON, and blocked phrases before the next step.",
	"license": "MIT",
	"homepage": "https://github.com/o-mid/n8n-nodes-agent-output-guard",
	"keywords": ["n8n-community-node-package"],
	"author": {
		"name": "Omid Mirzaei",
		"email": "omidomirzaei@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/o-mid/n8n-nodes-agent-output-guard.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "tsc -p tsconfig.json --pretty false && node --test test/check.test.js",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": ["dist"],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"nodes": ["dist/nodes/AgentOutputGuard/AgentOutputGuard.node.js"]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
